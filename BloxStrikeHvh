RunService.RenderStepped:Connect(function()
    --// ИСПРАВЛЕННЫЙ ТРЕТЬЕГО ЛИЦА (THIRDPERSON)
    if ThirdpersonEnabled and isAlive() then
        local myModel = getTFolder() and getTFolder():FindFirstChild(player.Name) or (getCTFolder() and getCTFolder():FindFirstChild(player.Name))
        local rootPart = myModel and myModel:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            player.CameraMode = Enum.CameraMode.Classic
            
            -- Получаем текущий поворот камеры (направление взгляда игрока)
            local camCFrame = camera.CFrame
            local camLookVector = camCFrame.LookVector
            
            -- Отодвигаем камеру назад от персонажа на заданную дистанцию (ThirdpersonDistance)
            -- Слегка поднимаем вверх (Vector3.new(0, 2, 0)), чтобы камера смотрела в район плеча/головы
            local targetPos = rootPart.Position + Vector3.new(0, 2, 0)
            local newCameraCFrame = CFrame.new(targetPos - (camLookVector * ThirdpersonDistance), targetPos)
            
            camera.CFrame = newCameraCFrame
            camera.CameraSubject = rootPart -- Возвращаем нормальный Subject, чтобы персонаж не ломался
            
            -- Отключаем баги с зумом
            player.CameraMaxZoomDistance = ThirdpersonDistance
            player.CameraMinZoomDistance = ThirdpersonDistance
        end
    else
        player.CameraMaxZoomDistance = 400
        player.CameraMinZoomDistance = 0.5
        if isAlive() then
            local myModel = getTFolder() and getTFolder():FindFirstChild(player.Name) or (getCTFolder() and getCTFolder():FindFirstChild(player.Name))
            local hum = myModel and myModel:FindFirstChildOfClass("Humanoid")
            if hum then camera.CameraSubject = hum end
        end
    end

    local enemyFolder = getEnemyFolder()
    if not enemyFolder then
        for _, t in pairs(ESP_Boxes) do if t.Box then t.Box:Remove() end end
        for _, t in pairs(ESP_Lines) do t:Remove() end
        for _, t in pairs(ESP_Bars) do if t.Bar then t.Bar:Remove() end if t.BG then t.BG:Remove() end end
        for _, t in pairs(ESP_Names) do t:Remove() end
        for _, t in pairs(ESP_Distances) do t:Remove() end
        for _, t in pairs(ESP_Heads) do t:Remove() end
        ESP_Boxes, ESP_Lines, ESP_Bars, ESP_Names, ESP_Distances, ESP_Heads = {}, {}, {}, {}, {}, {}
        return
    end

    for _, enemy in ipairs(enemyFolder:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        local root = enemy:FindFirstChild("HumanoidRootPart")
        local head = enemy:FindFirstChild("Head")
        
        if hum and hum.Health > 0 and root then
            local pos, onScreen = camera:WorldToViewportPoint(root.Position)
            
            -- Box ESP
            if ESP_Box then
                if not ESP_Boxes[enemy] then ESP_Boxes[enemy] = { Box = createDrawing("Square", {Visible = false, Thickness = 1, Color = Color3.fromRGB(255, 50, 50), Filled = false}) } end
                if onScreen then
                    local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                    local boxPos = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                    ESP_Boxes[enemy].Box.Size = size
                    ESP_Boxes[enemy].Box.Position = boxPos
                    ESP_Boxes[enemy].Box.Visible = true
                else
                    ESP_Boxes[enemy].Box.Visible = false
                end
            elseif ESP_Boxes[enemy] and ESP_Boxes[enemy].Box then
                ESP_Boxes[enemy].Box.Visible = false
            end

            -- Tracers
            if ESP_Snaplines then
                if not ESP_Lines[enemy] then ESP_Lines[enemy] = createDrawing("Line", {Visible = false, Thickness = 1, Color = Color3.fromRGB(200, 200, 255)}) end
                if onScreen then
                    ESP_Lines[enemy].From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    ESP_Lines[enemy].To = Vector2.new(pos.X, pos.Y)
                    ESP_Lines[enemy].Visible = true
                else
                    ESP_Lines[enemy].Visible = false
                end
            elseif ESP_Lines[enemy] then
                ESP_Lines[enemy].Visible = false
            end

            -- Health Bar
            if ESP_HealthBar then
                if not ESP_Bars[enemy] then
                    ESP_Bars[enemy] = {
                        BG = createDrawing("Square", {Visible = false, Filled = true, Color = Color3.fromRGB(0, 0, 0)}),
                        Bar = createDrawing("Square", {Visible = false, Filled = true, Color = Color3.fromRGB(0, 255, 0)})
                    }
                end
                if onScreen then
                    local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                    local boxPos = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                    local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    ESP_Bars[enemy].BG.Size = Vector2.new(3, size.Y)
                    ESP_Bars[enemy].BG.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                    ESP_Bars[enemy].BG.Visible = true
                    
                    ESP_Bars[enemy].Bar.Size = Vector2.new(1, size.Y * hpPct)
                    ESP_Bars[enemy].Bar.Position = Vector2.new(boxPos.X - 5, boxPos.Y + (size.Y * (1 - hpPct)))
                    ESP_Bars[enemy].Bar.Color = Color3.fromRGB(255 - (hpPct * 255), hpPct * 255, 0)
                    ESP_Bars[enemy].Bar.Visible = true
                else
                    ESP_Bars[enemy].BG.Visible = false
                    ESP_Bars[enemy].Bar.Visible = false
                end
            elseif ESP_Bars[enemy] then
                ESP_Bars[enemy].BG.Visible = false
                ESP_Bars[enemy].Bar.Visible = false
            end

            -- Name ESP
            if ESP_Name then
                if not ESP_Names[enemy] then ESP_Names[enemy] = createDrawing("Text", {Visible = false, Center = true, Size = 12, Color = Color3.fromRGB(255, 255, 255), Outline = true}) end
                if onScreen then
                    local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                    ESP_Names[enemy].Text = enemy.Name
                    ESP_Names[enemy].Position = Vector2.new(pos.X, pos.Y - size.Y / 2 - 16)
                    ESP_Names[enemy].Visible = true
                else
                    ESP_Names[enemy].Visible = false
                end
            elseif ESP_Names[enemy] then
                ESP_Names[enemy].Visible = false
            end

            -- Chams
            if ESP_Chams then
                local hl = enemy:FindFirstChild("HVH_Highlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "HVH_Highlight"
                    hl.FillColor = Color3.fromRGB(255, 50, 50)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.Parent = enemy
                end
            else
                local hl = enemy:FindFirstChild("HVH_Highlight")
                if hl then hl:Destroy() end
            end
        end
    end
end)

