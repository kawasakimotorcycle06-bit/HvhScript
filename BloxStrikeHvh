RunService.RenderStepped:Connect(function()
    if BhopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) and isAlive() then
        local myChar = player.Character
        if myChar then
            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping then hum.Jump = true end
        end
    end

    if SpeedHackEnabled and isAlive() then
        local myChar = player.Character
        if myChar then
            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = WalkSpeedValue end
        end
    end

    if SpinbotEnabled and isAlive() then
        SpeedLabel.Text = "Spin Speed: " .. tostring(SpinSpeed)
        local myModel = getTFolder() and getTFolder():FindFirstChild(player.Name) or (getCTFolder() and getCTFolder():FindFirstChild(player.Name))
        if myModel then
            local rootPart = myModel:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local currentPos = rootPart.CFrame.Position
                local spinAngle = (os.clock() * SpinSpeed) % 360
                rootPart.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, math.rad(spinAngle), 0)
            end
        end
    end
end)

